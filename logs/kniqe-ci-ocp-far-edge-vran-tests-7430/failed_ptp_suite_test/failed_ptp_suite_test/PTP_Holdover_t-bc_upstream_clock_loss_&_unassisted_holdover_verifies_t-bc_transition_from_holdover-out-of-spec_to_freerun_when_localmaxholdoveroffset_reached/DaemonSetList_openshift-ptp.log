            "spec": {
                "selector": {
                    "matchLabels": {
                        "app": "linuxptp-daemon"
                    }
                },
                "template": {
                    "metadata": {
                        "labels": {
                            "app": "linuxptp-daemon",
                            "role": "ptp"
                        },
                        "annotations": {
                            "target.workload.openshift.io/management": "{\"effect\": \"PreferredDuringScheduling\"}"
                        }
                    },
                    "spec": {
                        "volumes": [
                            {
                                "name": "config-volume",
                                "configMap": {
                                    "name": "ptp-configmap",
                                    "defaultMode": 420
                                }
                            },
                            {
                                "name": "leap-volume",
                                "configMap": {
                                    "name": "leap-configmap",
                                    "defaultMode": 420
                                }
                            },
                            {
                                "name": "linuxptp-certs",
                                "secret": {
                                    "secretName": "linuxptp-daemon-secret",
                                    "defaultMode": 420
                                }
                            },
                            {
                                "name": "pubsubstore",
                                "emptyDir": {}
                            },
                            {
                                "name": "event-bus-socket",
                                "emptyDir": {}
                            },
                            {
                                "name": "socket-dir",
                                "hostPath": {
                                    "path": "/var/run/ptp",
                                    "type": "DirectoryOrCreate"
                                }
                            }
                        ],
                        "containers": [
                            {
                                "name": "cloud-event-proxy",
                                "image": "registry.redhat.io/openshift4/ose-cloud-event-proxy-rhel9@sha256:5f126665e92f32ad66cf4377be8884ffb0d36b3c1e37833de7de3910a9012c40",
                                "args": [
                                    "--metrics-addr=127.0.0.1:9091",
                                    "--store-path=/store",
                                    "--transport-host=http://ptp-event-publisher-service-NODE_NAME.openshift-ptp.svc.cluster.local:9043",
                                    "--api-version=2.0",
                                    "--api-port=9043"
                                ],
                                "ports": [
                                    {
                                        "name": "metrics-port",
                                        "containerPort": 9091,
                                        "protocol": "TCP"
                                    },
                                    {
                                        "name": "api-port",
                                        "containerPort": 9043,
                                        "protocol": "TCP"
                                    }
                                ],
                                "env": [
                                    {
                                        "name": "PTP_PLUGIN",
                                        "value": "true"
                                    },
                                    {
                                        "name": "NODE_NAME",
                                        "valueFrom": {
                                            "fieldRef": {
                                                "apiVersion": "v1",
                                                "fieldPath": "spec.nodeName"
                                            }
                                        }
                                    },
                                    {
                                        "name": "NAME_SPACE",
                                        "value": "openshift-ptp"
                                    }
                                ],
                                "resources": {},
                                "volumeMounts": [
                                    {
                                        "name": "config-volume",
                                        "mountPath": "/etc/linuxptp"
                                    },
                                    {
                                        "name": "pubsubstore",
                                        "mountPath": "/store"
                                    },
                                    {
                                        "name": "event-bus-socket",
                                        "mountPath": "/cloud-native"
                                    },
                                    {
                                        "name": "socket-dir",
                                        "mountPath": "/var/run"
                                    }
                                ],
                                "terminationMessagePath": "/dev/termination-log",
                                "terminationMessagePolicy": "File",
                                "imagePullPolicy": "IfNotPresent"
                            },
                            {
                                "name": "kube-rbac-proxy",
                                "image": "registry.redhat.io/openshift4/ose-kube-rbac-proxy-rhel9@sha256:1915da376c32d710ec6f4e5431ca7d500c5c1862c4156c2a3befe3b98561debc",
                                "args": [
                                    "--logtostderr",
                                    "--secure-listen-address=:8443",
                                    "--tls-cipher-suites=TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_RSA_WITH_AES_128_CBC_SHA256,TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256,TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256",
                                    "--upstream=http://127.0.0.1:9091/",
                                    "--tls-private-key-file=/etc/metrics/tls.key",
                                    "--tls-cert-file=/etc/metrics/tls.crt",
                                    "--http2-disable=true"
                                ],
                                "ports": [
                                    {
                                        "name": "https",
                                        "containerPort": 8443,
                                        "protocol": "TCP"
                                    }
                                ],
                                "resources": {
                                    "requests": {
                                        "cpu": "10m",
                                        "memory": "20Mi"
                                    }
                                },
                                "volumeMounts": [
                                    {
                                        "name": "linuxptp-certs",
                                        "readOnly": true,
                                        "mountPath": "/etc/metrics"
                                    }
                                ],
                                "terminationMessagePath": "/dev/termination-log",
                                "terminationMessagePolicy": "FallbackToLogsOnError",
                                "imagePullPolicy": "IfNotPresent"
                            },
                            {
                                "name": "linuxptp-daemon-container",
                                "image": "registry.redhat.io/openshift4/ose-ptp-rhel9@sha256:0bf2e4999e35570c3f87b137028240f193401df75c2ea94c771044274d00b25a",
                                "command": [
                                    "/bin/bash",
                                    "-c",
                                    "--"
                                ],
                                "args": [
                                    "until [ $(curl -s -w '%{http_code}' 'http://localhost:9043/api/ocloudNotifications/v2/health' -o /dev/null) -eq 200 ]; do echo 'waiting for cloud event proxy to start'; sleep 10s; done; /usr/local/bin/ptp --alsologtostderr -v 10"
                                ],
                                "env": [
                                    {
                                        "name": "NODE_NAME",
                                        "valueFrom": {
                                            "fieldRef": {
                                                "apiVersion": "v1",
                                                "fieldPath": "spec.nodeName"
                                            }
                                        }
                                    },
                                    {
                                        "name": "POD_NAME",
                                        "valueFrom": {
                                            "fieldRef": {
                                                "apiVersion": "v1",
                                                "fieldPath": "metadata.name"
                                            }
                                        }
                                    },
                                    {
                                        "name": "LOGS_TO_SOCKET",
                                        "value": "true"
                                    },
                                    {
                                        "name": "PLUGINS",
                                        "value": "e810,e825,e830,ntpfailover"
                                    }
                                ],
                                "resources": {
                                    "requests": {
                                        "cpu": "20m",
                                        "memory": "50Mi"
                                    }
                                },
                                "volumeMounts": [
                                    {
                                        "name": "config-volume",
                                        "mountPath": "/etc/linuxptp"
                                    },
                                    {
                                        "name": "leap-volume",
                                        "mountPath": "/etc/leap"
                                    },
                                    {
                                        "name": "socket-dir",
                                        "mountPath": "/var/run"
                                    },
                                    {
                                        "name": "event-bus-socket",
                                        "mountPath": "/cloud-native"
                                    }
                                ],
                                "terminationMessagePath": "/dev/termination-log",
                                "terminationMessagePolicy": "File",
                                "imagePullPolicy": "IfNotPresent",
                                "securityContext": {
                                    "privileged": true
                                }
                            }
                        ],
                        "restartPolicy": "Always",
                        "terminationGracePeriodSeconds": 30,
                        "dnsPolicy": "ClusterFirstWithHostNet",
                        "nodeSelector": {
                            "node-role.kubernetes.io/master": ""
                        },
                        "serviceAccountName": "linuxptp-daemon",
                        "serviceAccount": "linuxptp-daemon",
                        "hostNetwork": true,
                        "hostPID": true,
                        "securityContext": {},
                        "schedulerName": "default-scheduler",
                        "tolerations": [
                            {
                                "operator": "Exists"
                            }
                        ],
                        "priorityClassName": "system-node-critical"
                    }
                },
                "updateStrategy": {
                    "type": "RollingUpdate",
                    "rollingUpdate": {
                        "maxUnavailable": "33%",
                        "maxSurge": 0
                    }
                },
                "revisionHistoryLimit": 10
            },
